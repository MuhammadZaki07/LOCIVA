# LOCIVA Frontend Environment Configuration

# Base application URL
VITE_APP_URL=http://localhost:5173

# Backend REST API endpoint (Sanctum-authenticated)
VITE_APP_BACK_END=http://127.0.0.1:8000/api

# Google OAuth Redirect URI
VITE_GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/auth/google/callback

# Basemap Providers Configuration
# Standard Map: OpenFreeMap Vector Positron / OSM Raster fallback (no key required)
# Carto API key (optional, for Carto styles/services)
VITE_CARTO_API_KEY=

# Satellite Imagery:
# Defaults to Esri World Imagery (high-resolution global coverage, no API key required)
# https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
# To configure an alternative custom satellite tile provider (e.g., Mapbox Satellite or Google Tiles proxy):
# VITE_SATELLITE_TILE_URL=https://api.mapbox.com/styles/v1/mapbox/satellite-v9/tiles/{z}/{x}/{y}?access_token=YOUR_MAPBOX_TOKEN
# VITE_SATELLITE_ATTRIBUTION="© Mapbox © OpenStreetMap"
